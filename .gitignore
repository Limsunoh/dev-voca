# Python
__pycache__/
*.py[cod]
.venv/
*.egg-info/

# Django
*.sqlite3
/backend/media/
/backend/staticfiles/

# 환경변수
.env
.env.*
!.env.example

# Node / Next.js
node_modules/
.next/
# D 드라이브가 ACL 미지원이라 .next 가 잠겨 지워지지 않는 일이 있다.
# 그때 distDir 을 임시로 바꿔 빌드하는데, 그 산출물이 커밋되지 않게 막는다.
.next-*/
out/

# 로컬 작업 노트 (커밋 안 함)
.claude/TROUBLESHOOTING.md
.claude/CODE_INSIGHTS.md
.claude/SLASH_COMMANDS_KR.md
.claude/settings.local.json
.claude/verification-state.json
.claude/devclock.py
.claude/dev_timing.jsonl
.claude/.devclock_open.json

# 브라우저 자동화 임시 산출물
.playwright-mcp/

# 리포지토리에 두면 안 되는 개인 파일
# 작업 폴더에 잠깐 내려받아 두는 일이 있어, git add -A 로 딸려 들어가지 않게 막는다.
recovery-codes.txt
*recovery-code*
*.pdf

# 다른 세션에서 받은 학습 데이터를 병합 전에 잠깐 두는 자리.
# seed_*.py 에 합치고 나면 지운다 - 두 벌이 남으면 어느 쪽이
# 최신인지 알 수 없게 된다.
/new_*.py
/review_chunks/

# 검증 중 만든 임시 산출물
/*.log
/backend/probe_*.txt
/backend/apps/**/tests_probe_*.py
# 병렬 세션이 테스트 DB 를 안 밟게 이름만 바꾼 설정. 커밋 대상이 아니다.
/backend/config/settings_dt*.py
/backend/config/settings_mine.py
/*.png
# 데이터 검수 스크립트가 레포 루트에 뱉는 것들
/inspect*.txt
/dup*.txt
/abbr_check*.txt
/cmp*.txt
/prons*.txt

# 에디터 / OS
.vscode/
.idea/
.DS_Store
Thumbs.db

# Claude Code 가 만드는 격리 작업공간. 저장소에 들어갈 것이 아니다.
.claude/worktrees/

# skills CLI 가 다른 에이전트 도구용으로 만드는 사본. .claude/skills/ 와 내용이
# 같아서 둘 다 커밋하면 3MB 가 두 벌이 된다. Claude Code 는 .claude/skills/ 를 읽는다.
.agents/
