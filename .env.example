# 이 파일을 .env 로 복사해서 사용한다. (.env 는 커밋되지 않음)

# Django
DJANGO_SECRET_KEY=change-me-in-production
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# PostgreSQL (docker compose 의 값과 일치해야 함)
# 호스트의 기존 PostgreSQL(5432)과 겹치지 않도록 컨테이너는 5433 으로 노출한다.
POSTGRES_DB=devvoca
POSTGRES_USER=devvoca
POSTGRES_PASSWORD=devvoca
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5433

# Docker 없이 sqlite 로 돌리려면 1
USE_SQLITE=0

# 프론트엔드 개발 서버
CORS_ALLOWED_ORIGINS=http://localhost:3000

# AI 콘텐츠 생성용 (관리자 배치 전용, 아직 미사용)
ANTHROPIC_API_KEY=
