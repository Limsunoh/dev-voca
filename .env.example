# 이 파일을 .env 로 복사해서 사용한다. (.env 는 커밋되지 않음)

# ---------- Django ----------
DJANGO_SECRET_KEY=change-me-in-production

# 로컬 개발은 1. 운영에서는 절대 켜지 말 것 (에러 페이지에 소스·설정이 노출된다).
# settings.py 기본값이 False 라, 여기서 명시적으로 켜야 로컬 디버그가 된다.
DJANGO_DEBUG=1

DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# ---------- PostgreSQL ----------
# 배포 플랫폼(Railway/Render)은 DATABASE_URL 을 자동 주입한다.
# 그게 있으면 아래 POSTGRES_* 는 무시된다.
# DATABASE_URL=postgres://user:pw@host:5432/dbname

# 로컬 Docker 용. 호스트에 이미 PostgreSQL 이 5432 를 쓰고 있어 컨테이너는 5433 으로 노출한다.
POSTGRES_DB=devvoca
POSTGRES_USER=devvoca
POSTGRES_PASSWORD=devvoca
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5433

# Docker 없이 sqlite 로 돌리려면 1 (운영에서는 쓰지 않는다)
USE_SQLITE=0

# ---------- 프론트엔드 ----------
# Next.js 개발 서버. 배포 후에는 실제 도메인을 콤마로 추가한다.
#   예: http://localhost:3000,https://devvoca.vercel.app
#
# 주의: Vercel 프리뷰 배포는 PR 마다 도메인이 바뀐다(devvoca-git-feat-xxx.vercel.app).
#       프리뷰에서 API 를 쓰려면 CORS_ALLOWED_ORIGIN_REGEXES 를 쓰거나
#       프리뷰용 도메인을 그때그때 추가해야 한다.
CORS_ALLOWED_ORIGINS=http://localhost:3000

# https 도메인은 여기에도 넣어야 Admin 로그인이 CSRF 로 막히지 않는다.
#   예: https://devvoca.vercel.app
# (스킴을 빠뜨리면 settings.py 가 https:// 를 붙여준다)
CSRF_TRUSTED_ORIGINS=

# HSTS. 브라우저가 기억해버려 되돌리기 어려우니 도메인·https 가 안정된 뒤에 켠다.
# 처음엔 짧게(예: 3600) 시작해 문제 없으면 31536000(1년)까지 늘린다. 0 이면 끔.
SECURE_HSTS_SECONDS=0

# ---------- AI 콘텐츠 생성 ----------
# 관리자 배치 전용. 사용자 요청 경로에서는 절대 호출하지 않는다(CLAUDE.md 규칙).
# 주의: 이 키가 있으면 ai_pipeline 테스트가 실제 API 를 호출해 과금될 수 있다.
#       테스트는 반드시 mock 으로 고정할 것.
ANTHROPIC_API_KEY=
