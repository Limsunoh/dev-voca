# 이 파일을 .env 로 복사해서 사용한다. (.env 는 커밋되지 않음)

# ---------- Django ----------
DJANGO_SECRET_KEY=change-me-in-production

# 로컬 개발은 1. 운영에서는 절대 켜지 말 것 (에러 페이지에 소스·설정이 노출된다).
# settings.py 기본값이 False 라, 여기서 명시적으로 켜야 로컬 디버그가 된다.
DJANGO_DEBUG=1

DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# ---------- PostgreSQL ----------
# 배포 플랫폼(Railway/Render)은 DATABASE_URL 을 자동 주입한다.
# 그게 있으면 아래 POSTGRES_* 는 무시된다.
# DATABASE_URL=postgres://user:pw@host:5432/dbname

# 로컬 Docker 용. 호스트에 이미 PostgreSQL 이 5432 를 쓰고 있어 컨테이너는 5433 으로 노출한다.
POSTGRES_DB=devvoca
POSTGRES_USER=devvoca
POSTGRES_PASSWORD=devvoca
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5433

# Docker 없이 sqlite 로 돌리려면 1 (운영에서는 쓰지 않는다)
USE_SQLITE=0

# ---------- 프론트엔드 ----------
# Next.js 개발 서버. 배포 후에는 실제 도메인을 콤마로 추가한다.
#   예: http://localhost:3000,https://devvoca.vercel.app
#
# 주의: Vercel 프리뷰 배포는 PR 마다 도메인이 바뀐다(devvoca-git-feat-xxx.vercel.app).
#       프리뷰에서 API 를 쓰려면 CORS_ALLOWED_ORIGIN_REGEXES 를 쓰거나
#       프리뷰용 도메인을 그때그때 추가해야 한다.
CORS_ALLOWED_ORIGINS=http://localhost:3000

# https 도메인은 여기에도 넣어야 Admin 로그인이 CSRF 로 막히지 않는다.
#   예: https://devvoca.vercel.app
# (스킴을 빠뜨리면 settings.py 가 https:// 를 붙여준다)
CSRF_TRUSTED_ORIGINS=

# HSTS. 브라우저가 기억해버려 되돌리기 어려우니 도메인·https 가 안정된 뒤에 켠다.
# 처음엔 짧게(예: 3600) 시작해 문제 없으면 31536000(1년)까지 늘린다. 0 이면 끔.
SECURE_HSTS_SECONDS=0

# ---------- AI 콘텐츠 생성 ----------
# 관리자 배치 전용. 사용자 요청 경로에서는 절대 호출하지 않는다(CLAUDE.md 규칙).
#
# 이 키는 Claude Code 구독과 별개인 API 종량제다.
# console.anthropic.com 에서 발급하고 크레딧을 충전해야 동작한다.
#
# 사용법:
#   python manage.py generate_words --count 20 --category git
#   python manage.py generate_words --count 5 --dry-run   (저장 없이 결과만)
#
# 생성물은 is_reviewed=False 로 저장되므로 Admin 에서 검수해야 사용자에게 보인다.
#
# 테스트는 가짜 생성기를 주입해 실제 API 를 부르지 않는다(apps/ai_pipeline/tests.py).
# 키가 있어도 manage.py test 로 과금되지 않는다.
ANTHROPIC_API_KEY=

# 구글 로그인. Google Cloud Console > 사용자 인증 정보 >
# OAuth 클라이언트 ID(웹 애플리케이션) 에서 발급받는다.
#
# 비워두면 구글 로그인만 못 쓰고 나머지는 그대로 돈다.
# SECRET 은 백엔드에만 둔다 - 프론트에 넣으면 브라우저로 새어나간다.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# 메일 발송. 이메일 변경의 본인 확인 링크가 이걸로 나간다.
#
# 비워두면 메일이 콘솔에 찍힌다(DEBUG=1 일 때). 로컬 개발은 그대로 두면
# 되고, 터미널에 뜬 링크를 복사해 브라우저에 넣으면 흐름이 끝까지 돈다.
#
# **운영에서는 반드시 채운다.** 비어 있으면 이메일 변경을 시도할 때
# 503 이 나간다 - 조용히 콘솔로 떨어져 사용자가 오지 않을 메일을 기다리는
# 것보다 낫다는 판단이다.
#
# Gmail 을 쓰려면 계정 비밀번호가 아니라 **앱 비밀번호**를 넣는다.
# 2단계 인증을 켠 뒤 Google 계정 > 보안 > 앱 비밀번호에서 발급하는
# 16자리다. 계정 비밀번호를 넣으면 인증이 거절된다.
#
# Gmail 은 하루 500통 제한이 있다. 사용자가 늘면 전용 발송 서비스로
# 옮긴다 - EMAIL_HOST 만 바꾸면 되게 해뒀다.
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=true
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
# 받는 사람에게 보이는 주소. 비우면 EMAIL_HOST_USER 를 쓴다.
DEFAULT_FROM_EMAIL=

# 확인 링크가 가리킬 화면 주소. 백엔드가 아니라 Next 쪽이다.
# 배포하면 실제 도메인으로 바꾼다 - 안 바꾸면 메일의 링크가 localhost 를
# 가리켜 받는 사람이 열 수 없다.
FRONTEND_BASE_URL=http://localhost:3000
