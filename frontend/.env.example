# 이 파일을 .env.local 로 복사해서 사용한다. (.env.local 은 커밋되지 않음)

# Django 백엔드 주소.
# 서버 컴포넌트에서만 쓰므로 NEXT_PUBLIC_ 접두사를 붙이지 않는다.
# (접두사를 붙이면 브라우저 번들에 주소가 노출된다.)
API_URL=http://127.0.0.1:8000

# 구글 로그인. 루트 .env 의 GOOGLE_CLIENT_ID 와 같은 값이다.
# 동의 화면 주소를 만들 때 쓴다. SECRET 은 여기 넣지 않는다.
GOOGLE_CLIENT_ID=

# 이 앱의 주소. 프록시 뒤에 배포할 때만 넣는다(예: https://dev-voca.vercel.app).
#
# 비워두면 요청에서 주소를 유추하는데, 프록시가 TLS 를 끊으면 https 로 들어온
# 요청이 앱에는 http 로 보인다. 그러면 구글이 등록된 주소와 다르다며 거절하고,
# 사용자에게는 "구글 로그인을 마치지 못했습니다" 만 보여 원인을 찾기 어렵다.
# 로컬 개발에서는 비워둔다.
APP_ORIGIN=
